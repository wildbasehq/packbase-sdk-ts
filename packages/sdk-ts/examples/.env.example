# Environment for the runnable SDK examples, not the documentation website.
# Copy this file to .env.local and fill in a key for your account.
# Keep .env.local private; do not commit API keys or Clerk JWTs.
#
# From the SDK repository root, explicitly load and export the local values:
#   cd packages/sdk-ts/examples
#   cp .env.example .env.local
#   # Edit .env.local before continuing.
#   set -a
#   . ./.env.local
#   set +a
#   bun run login-and-get-me/index.ts
#
# The example reads process.env; the commands above supply it explicitly rather
# than relying on automatic dotenv loading. Existing shell values are overwritten
# by the values sourced from .env.local.

# Required for the authenticated login-and-get-me example.
# Supply a Packbase API key or a valid Clerk JWT for the selected API server.
PACKBASE_API_KEY=

# Optional API base URL. An unset or empty value uses this same default in code.
PACKBASE_BASE_URL=https://vgs.packbase.app
